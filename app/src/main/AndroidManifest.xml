<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo para el servidor CalDAV que se configure (y, más adelante, las suscripciones). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Sin backup ni transferencia de datos a otro dispositivo (ver data_extraction_rules) y sin
        tráfico sin cifrar (ver network_security_config).
    -->
    <application
        android:name=".CalendarApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidCalendar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- Un alias por icono de la app: solo uno está activo (ver AppIcons). -->
        <activity-alias
            android:name=".IconLiquid"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMaterial"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_material"
            android:roundIcon="@mipmap/ic_launcher_material"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconSamsung"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_samsung"
            android:roundIcon="@mipmap/ic_launcher_samsung"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconIphone"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_iphone"
            android:roundIcon="@mipmap/ic_launcher_iphone"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMotorola"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_motorola"
            android:roundIcon="@mipmap/ic_launcher_motorola"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
